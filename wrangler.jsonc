{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home",
  "main": "cloud/worker.mjs",
  "compatibility_date": "2026-10-06",
  "keep_vars": true,
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "HOME_KV", "id": "REPLACE_WITH_YOUR_EXISTING_KV_NAMESPACE_ID" }
  ]
}
